# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy to `.env` for local development. Only VITE_* variables reach the browser,
# so never put a secret here — everything below ships in the built bundle.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API, including the version prefix.
# Local:      http://localhost:4000/api/v1
# Production: https://<your-backend-host>/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Name shown in the sidebar and browser title.
VITE_APP_NAME=ERP + CRM Portal
