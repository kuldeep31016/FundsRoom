        {
          "name": "Create challan — DRAFT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('challanId', data.id);",
                  "pm.test('challan number is auto-generated', () => {",
                  "  pm.expect(data.challanNumber).to.match(/^CH-\\d{4}-\\d{6}$/);",
                  "});",
                  "pm.test('status is DRAFT (stock untouched)', () => pm.expect(data.status).to.eql('DRAFT'));",
                  "pm.test('line stores the product snapshot', () => {",
                  "  pm.expect(data.items[0]).to.have.property('productName');",
                  "  pm.expect(data.items[0]).to.have.property('productSku');",
                  "  pm.expect(data.items[0]).to.have.property('unitPrice');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ],\n  \"status\": \"DRAFT\",\n  \"notes\": \"Awaiting transport confirmation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] },
            "description": "A draft never reduces stock. The challan number is allocated atomically and each line stores a snapshot of the product."
          },
          "response": []
        },
