      "item": [
        {
          "name": "List stock movements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stock/movements?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["stock", "movements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "productId", "value": "", "description": "Filter to one product", "disabled": true },
