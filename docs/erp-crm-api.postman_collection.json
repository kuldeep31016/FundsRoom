              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "CONFIRMED", "description": "DRAFT | CONFIRMED | CANCELLED", "disabled": true },
                { "key": "search", "value": "CH-2026", "description": "Challan number or customer", "disabled": true },
                { "key": "customerId", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
