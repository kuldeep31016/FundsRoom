# ---------------------------------------------------------------------------
# Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Port the HTTP server listens on. Render/Railway inject this automatically.
PORT=4000
# One of: debug | info | warn | error | silent
LOG_LEVEL=info

# Database ------------------------------------------------------------------
# Full PostgreSQL connection string.
# Local (docker compose): postgres://erp_user:erp_password@localhost:5433/erp_crm
# Neon/Supabase/Render:   postgres://<user>:<password>@<host>/<db>
DATABASE_URL=postgres://erp_user:erp_password@localhost:5433/erp_crm
# Set to "true" for managed providers that require TLS (Neon, Supabase, Render).
DATABASE_SSL=false
# Maximum pooled connections. Keep low (e.g. 5) on free hosting tiers.
DATABASE_POOL_MAX=10

# Separate database used by `npm test`. The suite DROPs and recreates its schema,
# so this must never point at development or production data.
TEST_DATABASE_URL=postgres://erp_user:erp_password@localhost:5433/erp_crm_test

# Authentication ------------------------------------------------------------
# Secret used to sign JWTs. Minimum 16 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime, e.g. 15m | 8h | 7d
JWT_EXPIRES_IN=8h
# bcrypt cost factor for password hashing (4-15).
BCRYPT_SALT_ROUNDS=10

# HTTP ----------------------------------------------------------------------
# Comma-separated list of browser origins allowed by CORS.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter budget for POST /auth/login (brute-force protection).
AUTH_RATE_LIMIT_MAX=20

# Seeding -------------------------------------------------------------------
# Password assigned to every demo user created by `npm run seed`.
# Change this before seeding anything that is publicly reachable.
SEED_DEFAULT_PASSWORD=Password@123

# Company letterhead --------------------------------------------------------
# Printed at the top of every generated challan PDF (GET /challans/:id/pdf).
COMPANY_NAME=Shreeji Wholesale Distributors
COMPANY_ADDRESS=Unit 14, MIDC Industrial Estate, Pune, Maharashtra 411019
COMPANY_GSTIN=27AAPFU0939F1ZV
COMPANY_PHONE=+91 20 4567 8900
COMPANY_EMAIL=operations@shreejiwholesale.test

# Object storage ------------------------------------------------------------
# Product images. Leave S3_BUCKET unset to disable the feature entirely — the
# app still runs and the upload endpoints return a clear 503.
#
# Local (MinIO via docker compose): endpoint set, path-style addressing on.
# AWS S3 production: leave S3_ENDPOINT and S3_FORCE_PATH_STYLE unset/false.
S3_BUCKET=erp-crm-product-images
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=erp_minio_user
S3_SECRET_ACCESS_KEY=erp_minio_password
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Public base URL for stored objects (CloudFront or the bucket URL).
# When unset, short-lived presigned GET URLs are issued instead.
S3_PUBLIC_BASE_URL=http://localhost:9000/erp-crm-product-images
S3_UPLOAD_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=5242880
